# Base de datos. Vacío: PGlite embebido en .data/ (desarrollo). En producción: Postgres.
DATABASE_URL=

# URL pública, para el redirect de Wompi. En local: http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Abono que se paga en línea para reservar, en pesos. Se descuenta en la barbería.
ABONO_COP=10000

# Wompi (modo pruebas: llaves pub_test_ / prv_test_ desde el dashboard de comercios).
# Sin estas llaves, los pagos usan la pasarela simulada (solo en desarrollo, o con PAGOS_SIMULADOS=1).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
PAGOS_SIMULADOS=

# Datos de desarrollo creados por `npm run db:seed` (solo para tu máquina).
SEED_ADMIN_EMAIL=admin@filo.test
SEED_ADMIN_PASSWORD=barberia-local-123
SEED_CLIENT_EMAIL=cliente@filo.test
SEED_CLIENT_PASSWORD=cliente-local-123
